# Base environment configuration
# This file contains default/common settings
# Environment-specific settings override these in .env.dev or .env.production

# ============================================
# Basic Server Configuration
# ============================================
# Server IP address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
IP=0.0.0.0

# Server PORT (Node.js가 직접 리스닝하는 포트)
PORT=8500

# Node environment (development, dev, production)
# NODE_ENV=development

# ============================================
# WAS Deployment Configuration
# ============================================
# WAS 타입: 'nginx', 'tomcat', 'none' (직접 실행)
# none: Node.js가 직접 외부에 노출 (개발/테스트용)
# nginx: Nginx reverse proxy 사용
# tomcat: Tomcat reverse proxy 사용 (또는 별도 프록시)
WAS_TYPE=none

# Reverse Proxy 사용 여부 (WAS_TYPE이 none이 아니면 자동 true)
# true: WAS를 통한 프록시 모드, false: 직접 노출
REVERSE_PROXY=false

# 내부 포트 (Node.js가 실제로 리스닝하는 포트)
# Reverse Proxy 사용 시 보통 localhost:내부포트로 바인딩
INTERNAL_PORT=8500

# 외부 포트 (WAS가 외부에 노출하는 포트, 정보용)
# 실제 포트는 WAS 설정 파일에서 관리
EXTERNAL_PORT=8500

# 프록시 경로 (예: /ws, /websocket, /api/ws)
# Nginx/Tomcat에서 Node.js로 프록시할 경로
PROXY_PATH=/ws

# ============================================
# SSL/TLS Configuration
# ============================================
# SSL/TLS 사용 여부 (WAS에서 SSL 처리 시 false)
SSL_ENABLED=false

# SSL 인증서 경로 (SSL_ENABLED=true일 때 필요)
SSL_CERT_PATH=/path/to/cert.pem

# SSL 개인키 경로 (SSL_ENABLED=true일 때 필요)
SSL_KEY_PATH=/path/to/key.pem

# ============================================
# Health Check Configuration
# ============================================
# Health check 엔드포인트 활성화 여부
HEALTH_CHECK_ENABLED=true

# Health check 경로
HEALTH_CHECK_PATH=/health

# ============================================
# WebSocket Configuration
# ============================================
# IP당 최대 연결 수 (0 = 제한 없음)
WS_MAX_CONNECTIONS_PER_IP=0

# WebSocket Ping 간격 (밀리초, 0 = 비활성화)
WS_PING_INTERVAL=30000

# 최대 메시지 크기 (바이트, 0 = 제한 없음)
# 권장값: 1048576 (1MB) - 일반적인 서비스 사용에 지장 없음
# 대용량 페이로드 필요 시: 5242880 (5MB)
WS_MAX_MESSAGE_SIZE=1048576

# ============================================
# Logging Configuration
# ============================================
# 로그 레벨: debug | info | warn | error
# debug: 모든 로그 출력 (개발용)
# info: 일반 정보 로그 (기본값, 운영 권장)
# warn: 경고 이상만 출력
# error: 에러만 출력
LOG_LEVEL=info

# 메시지 페이로드 로깅 여부 (true | false)
# true: 메시지 본문을 로그에 포함 (디버깅용)
# false: 메시지 본문 제외 (기본값, 보안/성능 고려)
LOG_PAYLOAD=true

# 페이로드 최대 길이 (문자 수)
# LOG_PAYLOAD=true일 때 페이로드가 이 길이를 초과하면 잘림
LOG_MAX_LEN=2000

LOG_PRETTY=true

LOG_COLOR=true

