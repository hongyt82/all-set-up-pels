# Development environment configuration
# Overrides .env settings for development

# ============================================
# Basic Server Configuration
# ============================================
# Server IP address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
IP=0.0.0.0

# Server PORT (Node.js가 직접 리스닝하는 포트)
PORT=8600

# Node environment
NODE_ENV=development

# ============================================
# WAS Deployment Configuration
# ============================================
# 개발 환경: 직접 실행 (WAS 없음)
WAS_TYPE=none
REVERSE_PROXY=false
INTERNAL_PORT=8600
EXTERNAL_PORT=8600
PROXY_PATH=/ws

# ============================================
# SSL/TLS Configuration
# ============================================
SSL_ENABLED=false

# ============================================
# Health Check Configuration
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================
# WebSocket Configuration
# ============================================
WS_MAX_CONNECTIONS_PER_IP=0
WS_PING_INTERVAL=30000
# 개발 환경: 대용량 메시지 테스트를 위해 더 큰 값 설정 가능
WS_MAX_MESSAGE_SIZE=5242880

# ============================================
# Logging Configuration
# ============================================
# 개발 환경: 상세 로그 활성화 (디버깅 편의)
# 로그 레벨: debug (모든 로그 출력)
LOG_LEVEL=debug

# 메시지 페이로드 로깅: true (디버깅 시 메시지 내용 확인 가능)
LOG_PAYLOAD=true

# 페이로드 최대 길이: 5000 (개발 환경에서는 더 긴 페이로드도 확인 가능)
LOG_MAX_LEN=5000

LOG_PRETTY=true

LOG_COLOR=true

