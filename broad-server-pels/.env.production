# Production environment configuration
# Overrides .env settings for production

# ============================================
# Basic Server Configuration
# ============================================
# Server IP address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Reverse Proxy 사용 시 보통 127.0.0.1 또는 0.0.0.0
# production 으로 임의로 build 배포 테스트시에 외부 접속 하려고 하면 0.0.0.0 같은 PC 에서만 접속이면 127.0.0.1
IP=0.0.0.0

# Server PORT (Node.js가 직접 리스닝하는 포트)
# Reverse Proxy 사용 시 내부 포트로 사용
PORT=8700

# Node environment
NODE_ENV=production

# ============================================
# WAS Deployment Configuration
# ============================================
# 프로덕션 WAS 타입: 'nginx' 또는 'tomcat'
# nginx: Nginx reverse proxy 사용 (권장)
# tomcat: Tomcat reverse proxy 사용
WAS_TYPE=nginx

# Reverse Proxy 사용 여부
REVERSE_PROXY=true

# 내부 포트 (Node.js가 실제로 리스닝하는 포트)
# Nginx/Tomcat이 이 포트로 프록시
INTERNAL_PORT=8700

# 외부 포트 (WAS가 외부에 노출하는 포트, 정보용)
# 실제 포트는 Nginx/Tomcat 설정에서 관리 (보통 80/443)
EXTERNAL_PORT=443

# 프록시 경로 (예: /ws, /websocket, /api/ws)
# Nginx/Tomcat에서 Node.js로 프록시할 경로
PROXY_PATH=/ws

# ============================================
# SSL/TLS Configuration
# ============================================
# SSL/TLS 사용 여부
# true: Node.js에서 직접 SSL 처리 (비권장, WAS에서 처리 권장)
# false: WAS(Nginx/Tomcat)에서 SSL 처리 (권장)
SSL_ENABLED=false

# SSL 인증서 경로 (SSL_ENABLED=true일 때만 사용)
SSL_CERT_PATH=/path/to/cert.pem

# SSL 개인키 경로 (SSL_ENABLED=true일 때만 사용)
SSL_KEY_PATH=/path/to/key.pem

# ============================================
# Health Check Configuration
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================
# WebSocket Configuration
# ============================================
# IP당 최대 연결 수 (0 = 제한 없음, 프로덕션에서는 제한 권장)
WS_MAX_CONNECTIONS_PER_IP=100

# WebSocket Ping 간격 (밀리초, 연결 유지용)
WS_PING_INTERVAL=30000

# 최대 메시지 크기 (바이트, 0 = 제한 없음)
# 프로덕션 권장값: 1048576 (1MB) - 서비스 사용에 지장 없으면서 메모리 보호
WS_MAX_MESSAGE_SIZE=1048576

# ============================================
# Logging Configuration
# ============================================
# 프로덕션 환경: 보안/성능 고려한 로그 설정
# 로그 레벨: info (일반 정보만 출력, 에러/경고 포함)
# debug 레벨은 성능 저하 및 로그 볼륨 증가 가능성 있음
LOG_LEVEL=info

# 메시지 페이로드 로깅: false (보안 및 성능 고려)
# 프로덕션에서는 메시지 본문에 민감 정보가 포함될 수 있으므로 비활성화 권장
LOG_PAYLOAD=false

# 페이로드 최대 길이: 2000 (LOG_PAYLOAD=true로 변경 시에도 제한 적용)
LOG_MAX_LEN=2000

LOG_PRETTY=false

LOG_COLOR=false
