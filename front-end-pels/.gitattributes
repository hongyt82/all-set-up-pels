# Git attributes for cross-platform compatibility
# This file ensures consistent behavior across Mac, Windows, and Linux

# ============================================
# Line ending settings
# ============================================

# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for all text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Force LF for Unix-specific files
*.sh text eol=lf
*.bash text eol=lf

# ============================================
# Binary files
# ============================================

# Treat these as binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary

# ============================================
# Package manager files
# ============================================

# Ensure package-lock.json uses LF
package-lock.json text eol=lf

# ============================================
# IDE and editor files
# ============================================

# VSCode settings
.vscode/settings.json text eol=lf
.vscode/extensions.json text eol=lf
.vscode/launch.json text eol=lf
.vscode/tasks.json text eol=lf

# ============================================
# Configuration files
# ============================================

# Config files
*.config.js text eol=lf
*.config.ts text eol=lf
*.config.cjs text eol=lf
*.config.mjs text eol=lf
babel.config.* text eol=lf
eslint.config.* text eol=lf
prettier.config.* text eol=lf
tailwind.config.* text eol=lf
vite.config.* text eol=lf
tsconfig*.json text eol=lf

# ============================================
# Documentation
# ============================================

# Documentation files
*.md text eol=lf
README* text eol=lf
CHANGELOG* text eol=lf
LICENSE* text eol=lf
CONTRIBUTING* text eol=lf

# ============================================
# Git files
# ============================================

# Git configuration
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf
