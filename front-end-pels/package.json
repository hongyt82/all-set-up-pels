{
  "name": "pdf-formatter",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "vite --mode localdev --host 0.0.0.0 --port 4008",
    "dev": "vite --mode dev",
    "prod_test:run": "vite --mode production",
    "build:prod": "vite build --mode production",
    "serve": "vite preview --port 5000",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" package.json",
    "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" package.json",
    "preview": "vite preview --port 5050",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "version:status": "node scripts/version-manager.cjs status",
    "version:patch": "node scripts/version-manager.cjs patch",
    "version:minor": "node scripts/version-manager.cjs minor",
    "version:major": "node scripts/version-manager.cjs major",
    "version:set": "node scripts/version-manager.cjs set",
    "version:build": "node scripts/version-manager.cjs build",
    "package-offline": "node scripts/package-offline.js",
    "verify-offline": "node scripts/verify-offline.js",
    "postinstall": "node scripts/postinstall.js"
  },
